# ==============================================================================
# ERAH AI ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your keys: cp .env.example .env
# ==============================================================================

# Project Details
ERAH_ENV=development
ERAH_DEBUG=true
ERAH_LOG_LEVEL=INFO

# LLM Providers (for Phase 02+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Embedding & Vector Database (for Phase 04+)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
QDRANT_URL=
QDRANT_API_KEY=

# LangChain & Observability (for Phase 07+)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=erah-ai

# Security & Secret Keys
ERAH_SECRET_KEY=erah_dev_secret_key_change_in_production
